generator client {
  provider     = "prisma-client"
  output       = "../generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String                 @id @default(uuid())
  firebaseUid           String                 @unique
  firstName             String
  lastName              String
  email                 String                 @unique
  phoneNumber           String?
  // Public URL of the profile photo; null until they upload one.
  avatarUrl             String?
  role                  Role
  agreedToTerms         Boolean                @default(false)
  // Mirrors Firebase's emailVerified;
  isVerified            Boolean                @default(false)
  // Farmers and agents only: set when a farmer's first farm is verified, or
  // (once the admin flow exists) when an admin verifies an agent. Until then
  // ActivationGuard locks them out. Other roles leave it null.
  activatedAt           DateTime?
  // Set with the temporary password sent in a farmer's invite;
  // PasswordChangeGuard blocks most routes until changePassword clears it.
  mustChangePassword    Boolean                @default(false)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  farmer                Farmer?
  agent                 Agent?
  buyer                 Buyer?
  admin                 Admin?
  conversationsAsAgent  Conversation[]         @relation("ConversationAgent")
  messages              Message[]
  confirmedPayments     Payment[]              @relation("PaymentConfirmedBy")
  refundsInitiated      Refund[]               @relation("RefundInitiatedBy")
  bankAccountsSet       FarmerBankAccount[]    @relation("BankAccountSetBy")
  payoutsApproved       Payout[]               @relation("PayoutApprovedBy")
  refreshToken          RefreshToken?
  emailVerificationCode EmailVerificationCode?
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One live code per user; issuing a new one overwrites it.
model EmailVerificationCode {
  userId              String   @id
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // HMAC-SHA256 keyed by OTP_SECRET: a bare hash of 4 digits is reversible.
  codeHash            String
  expiresAt           DateTime
  attempts            Int      @default(0)
  lastSentAt          DateTime
  // Codes sent since sendWindowStartedAt; caps resends at a few a day.
  sendCount           Int      @default(0)
  sendWindowStartedAt DateTime @default(now())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Buyer {
  id               String            @id @default(uuid())
  // Public code (BY-000123), backed by a hand-made sequence like Farmer.farmerId.
  buyerId          String            @unique @default(dbgenerated("('BY-'::text || lpad((nextval('\"Buyer_buyerId_seq\"'::regclass))::text, 6, '0'::text))"))
  userId           String            @unique
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  stateId          String?
  state            State?            @relation(fields: [stateId], references: [id], onDelete: Restrict)
  lgaId            String?
  lga              Lga?              @relation(fields: [lgaId], references: [id], onDelete: Restrict)
  orders           Order[]
  cartItems        CartItem[]
  cartMerges       CartMerge[]
  checkouts        Checkout[]
  sourcingRequests SourcingRequest[]
  addresses        Address[]
  conversations    Conversation[]    @relation("ConversationBuyer")
  // PERSON leaves the five company columns null. COMPANY requires all five.
  // The split is the hand-written check Buyer_company_fields_check.
  buyerType        BuyerType         @default(PERSON)
  legalName        String?
  department       String?
  contactName      String?
  contactPhone     String?
  paymentTerms     String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model Admin {
  id        String   @id @default(uuid())
  // Public code (AD-000123), backed by a hand-made sequence like Farmer.farmerId.
  adminId   String   @unique @default(dbgenerated("('AD-'::text || lpad((nextval('\"Admin_adminId_seq\"'::regclass))::text, 6, '0'::text))"))
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Farmer {
  id            String             @id @default(uuid())
  farmerId      String             @unique @default(dbgenerated("('FRM-'::text || lpad((nextval('\"Farmer_farmerId_seq\"'::regclass))::text, 6, '0'::text))"))
  userId        String             @unique
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Set at profile setup; the agent checks them during farm verification.
  idType        IdType?
  idNumber      String?
  // Private-bucket key.
  idDocumentKey String?
  farms         Farm[]
  bankAccount   FarmerBankAccount?
  payouts       Payout[]
  auditEvents   AuditEvent[]
  // Account standing. DISABLED locks farmer routes; an approved verification sets it back to ACTIVE.
  status        FarmerStatus       @default(ACTIVE)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

model Farm {
  id                   String                 @id @default(uuid())
  // Public, human-readable code (LF-000123), backed by a hand-made sequence
  // like Farmer.farmerId.
  farmCode             String                 @unique @default(dbgenerated("('LF-'::text || lpad((nextval('\"Farm_farmCode_seq\"'::regclass))::text, 6, '0'::text))"))
  // References Farmer.id, not the public Farmer.farmerId code.
  ownerId              String
  owner                Farmer                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name                 String
  country              String                 @default("NG")
  stateId              String
  state                State                  @relation(fields: [stateId], references: [id], onDelete: Restrict)
  lgaId                String
  lga                  Lga                    @relation(fields: [lgaId], references: [id], onDelete: Restrict)
  // Street address; state and LGA are the structured part.
  location             String
  size                 Float
  unit                 String                 @default("ha")
  mainProduce          String
  isExporting          Boolean                @default(false)
  // Private-bucket keys, uploaded with the farm. Ownership is optional only
  // temporarily; restore NOT NULL once it is required again.
  ownershipDocumentKey String?
  chiefConfirmationKey String?
  // Denormalised from the latest FarmVerification and always written in the
  // same transaction, so lists filter on it without a join.
  verificationStatus   FarmVerificationStatus @default(PENDING)
  isClustered          Boolean                @default(false)
  // Restrict: deleting an agent (and with it their cluster) while farms are
  // still in it would otherwise leave those farms isClustered with no cluster.
  clusterId            String?
  cluster              Cluster?               @relation(fields: [clusterId], references: [id], onDelete: Restrict)
  // Informational only; plays no part in assignment.
  referralAgentId      String?
  referralAgent        Agent?                 @relation("FarmReferral", fields: [referralAgentId], references: [id], onDelete: SetNull)
  produce              Produce[]
  orders               Order[]
  verifications        FarmVerification[]
  auditEvents          AuditEvent[]
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@index([ownerId])
  @@index([lgaId])
  @@index([clusterId])
}

model State {
  id        String    @id @default(uuid())
  name      String    @unique
  lgas      Lga[]
  farms     Farm[]
  agents    Agent[]
  buyers    Buyer[]
  addresses Address[]
}

model Lga {
  id        String    @id @default(uuid())
  stateId   String
  state     State     @relation(fields: [stateId], references: [id], onDelete: Restrict)
  name      String
  farms     Farm[]
  agents    Agent[]
  buyers    Buyer[]
  addresses Address[]

  @@unique([stateId, name])
}

model Agent {
  id            String              @id @default(uuid())
  // Public code (AG-000123), backed by a hand-made sequence like Farmer.farmerId.
  agentId       String              @unique @default(dbgenerated("('AG-'::text || lpad((nextval('\"Agent_agentId_seq\"'::regclass))::text, 6, '0'::text))"))
  userId        String              @unique
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  country       String              @default("NG")
  // Location and ID are null until profile setup.
  stateId       String?
  state         State?              @relation(fields: [stateId], references: [id], onDelete: Restrict)
  lgaId         String?
  lga           Lga?                @relation(fields: [lgaId], references: [id], onDelete: Restrict)
  idType        IdType?
  idNumber      String?
  // Private-bucket key.
  idDocumentKey String?
  // Set by an admin; only verified agents are assigned farms.
  isVerified    Boolean             @default(false)
  verifiedAt    DateTime?
  cluster       Cluster?
  verifications FarmVerification[]
  declines      AssignmentDecline[]
  handovers     OrderHandover[]
  referredFarms Farm[]              @relation("FarmReferral")
  auditEvents   AuditEvent[]
  assignedSourcingRequests SourcingRequest[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([lgaId, isVerified])
}

model AuditEvent {
  id          String         @id @default(uuid())
  occurredAt  DateTime       @default(now())
  actorType   AuditActorType
  farmerId    String?
  farmer      Farmer?        @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  agentId     String?
  agent       Agent?         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  farmId      String?
  farm        Farm?          @relation(fields: [farmId], references: [id], onDelete: SetNull)
  sourcingRequestId String?
  sourcingRequest   SourcingRequest? @relation(fields: [sourcingRequestId], references: [id], onDelete: Cascade)
  category    AuditCategory
  title       String
  summary     String
  actionLabel String?
  resource    AuditResource?
  resourceId  String?

  @@index([farmerId, occurredAt])
  @@index([agentId, occurredAt])
  @@index([farmId, occurredAt])
  @@index([sourcingRequestId, occurredAt])
}

// Exactly one per agent, created with it: the farms that agent manages.
model Cluster {
  id        String   @id @default(uuid())
  agentId   String   @unique
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  // "<LGA> Hub", set whenever the agent sets their LGA.
  name      String?
  farms     Farm[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One verification round of a farm. A farm keeps every round, and at most one
// is open (UNASSIGNED/ASSIGNED/IN_PROGRESS): a partial unique index
// hand-written in the migration, because Prisma can't express one.
model FarmVerification {
  id                 String                 @id @default(uuid())
  farmId             String
  farm               Farm                   @relation(fields: [farmId], references: [id], onDelete: Cascade)
  agentId            String?
  agent              Agent?                 @relation(fields: [agentId], references: [id], onDelete: SetNull)
  status             VerificationTaskStatus @default(UNASSIGNED)
  // Location step. false is a discrepancy: needs lat, lng, a note and evidence.
  locationMatches    Boolean?
  discrepancyLat     Decimal?               @db.Decimal(9, 6)
  discrepancyLng     Decimal?               @db.Decimal(9, 6)
  discrepancyNote    String?
  identityNote       String?
  // Measured on site; never overwrites Farm.size.
  measuredSize       Float?
  estimatedYield     Float?
  estimatedYieldUnit String?
  generalNote        String?
  rejectionReason    String?
  // MISSING_DOCS and INCOMPLETE follow the expected documents. AWAITING_DOCS
  // and FOLLOW_UP stay until someone sets a different status. An information
  // request sets AWAITING_DOCS.
  evidenceStatus     EvidenceStatus         @default(MISSING_DOCS)
  // The files a round always collects. Identity and ownership stay on the
  // farmer and the farm; issue photos stay in VerificationEvidence.
  locationEvidenceKey    String?
  productionEvidenceKey  String?
  farmPlotSketchKey      String?
  harvestEstimateKey     String?
  // The note sent to the assigned agent with the last information request.
  informationRequestNote String?
  informationRequestedAt DateTime?
  startedAt          DateTime?
  decidedAt          DateTime?
  checks             VerificationCheck[]
  evidence           VerificationEvidence[]
  declines           AssignmentDecline[]
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([farmId])
  @@index([agentId, status])
  @@index([status])
}

model VerificationCheck {
  id             String               @id @default(uuid())
  verificationId String
  verification   FarmVerification     @relation(fields: [verificationId], references: [id], onDelete: Cascade)
  key            VerificationCheckKey
  result         CheckResult
  note           String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([verificationId, key])
}

// Issue photos only. The expected documents are columns on FarmVerification.
// A CHECK constraint ties checkKey to kind CHECK and photoSlot to kind PHOTO.
model VerificationEvidence {
  id             String                @id @default(uuid())
  verificationId String
  verification   FarmVerification      @relation(fields: [verificationId], references: [id], onDelete: Cascade)
  kind           EvidenceKind
  checkKey       VerificationCheckKey?
  photoSlot      PhotoSlot?
  // Private-bucket key.
  storageKey     String
  createdAt      DateTime              @default(now())

  @@index([verificationId])
}

model AssignmentDecline {
  id             String           @id @default(uuid())
  verificationId String
  verification   FarmVerification @relation(fields: [verificationId], references: [id], onDelete: Cascade)
  agentId        String
  agent          Agent            @relation(fields: [agentId], references: [id], onDelete: Cascade)
  reason         String
  createdAt      DateTime         @default(now())

  @@unique([verificationId, agentId])
}

model Produce {
  id               String           @id @default(uuid())
  farmId           String
  farm             Farm             @relation(fields: [farmId], references: [id], onDelete: Cascade)
  name             String
  // Original stock listed at creation. Immutable: actual/floating move as
  // orders come in, but this stays the record of what was first listed.
  quantity         Int
  // Stock not yet committed to a CONFIRMED order; mirrors quantity on
  // creation, drops on confirm.
  actualQuantity   Int
  // Stock buyers can still order: actual minus PENDING reservations; mirrors
  // quantity on creation, drops on order.
  floatingQuantity Int
  // Unit the quantities and pricePerUnit are expressed in, e.g. "kg" or "crate".
  unit             String
  pricePerUnit     Decimal          @db.Decimal(12, 2)
  imageUrl         String?
  status           ProduceStatus    @default(DRAFT)
  type             ProduceType      @default(LOCAL)
  // Optional so listings created before categories existed stay valid.
  category         ProduceCategory?
  description      String?
  // Short free text shown as "Specs", e.g. "Grade A — Fresh Harvest".
  specs            String?
  cartItems        CartItem[]
  orders           Order[]
  sourcingAllocations SourcingAllocation[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  // Target of Order's composite FK, so an order's farm always matches its produce's farm.
  @@unique([id, farmId])
  @@index([farmId])
}

model Order {
  id                 String          @id @default(uuid())
  // Public, human-readable code (ORD-000123), backed by a hand-made sequence
  // like Farmer.farmerId.
  orderNumber        String          @unique @default(dbgenerated("('ORD-'::text || lpad((nextval('\"Order_orderNumber_seq\"'::regclass))::text, 6, '0'::text))"))
  produceId          String
  farmId             String
  buyerId            String
  // Orders are history: Restrict stops a produce, farm or buyer delete from erasing them.
  produce            Produce         @relation(fields: [produceId, farmId], references: [id, farmId], onDelete: Restrict)
  farm               Farm            @relation(fields: [farmId], references: [id], onDelete: Restrict)
  buyer              Buyer           @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  quantity           Int
  totalPrice         Decimal         @db.Decimal(12, 2)
  status             OrderStatus     @default(PENDING)
  // Snapshot of the produce's name at order time: lists show it without a
  // join, and a later rename doesn't rewrite order history.
  produceName        String
  // Snapshot of the produce's type at order time, so lists can tag and filter
  // local vs export orders without joining Produce.
  type               ProduceType
  // Null only for orders placed before checkouts existed.
  checkoutId         String?
  checkout           Checkout?       @relation(fields: [checkoutId], references: [id], onDelete: Restrict)
  // Required whenever status is CANCELLED.
  cancellationReason String?
  // Created when the farmer starts preparing; READY needs every item ticked.
  checklist          OrderChecklist?
  // Created when the order is marked READY; the agent takes it from there.
  handover           OrderHandover?
  // Set by logistics (not built yet); starts the payout hold.
  fulfilledAt        DateTime?
  payoutItems        PayoutItem[]
  refunds            Refund[]
  conversation       Conversation?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([farmId])
  @@index([produceId])
  @@index([buyerId])
  @@index([checkoutId])
}

model OrderChecklist {
  orderId        String   @id
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  harvested      Boolean  @default(false)
  sorted         Boolean  @default(false)
  packaged       Boolean  @default(false)
  readyForPickup Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// The agent's side of a READY order: verify the goods at the farm, then hand
// them to logistics, which ships the order. Opened by OrderService.markReady.
model OrderHandover {
  orderId          String         @id
  order            Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // The agent whose cluster held the farm when the order became READY. Null
  // when the farm was out of every cluster (mid re-verification); approving
  // the farm's next round claims it.
  agentId          String?
  agent            Agent?         @relation(fields: [agentId], references: [id], onDelete: SetNull)
  status           HandoverStatus @default(PENDING)
  verificationNote String?
  verifiedAt       DateTime?
  // Who took the goods; there is no logistics model yet.
  recipientName    String?
  recipientPhone   String?
  handoverNote     String?
  handedOverAt     DateTime?
  proofs           HandoverProof[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([agentId, status])
}

// Photos the agent takes at the farm as proof of the goods.
model HandoverProof {
  id         String        @id @default(uuid())
  orderId    String
  handover   OrderHandover @relation(fields: [orderId], references: [orderId], onDelete: Cascade)
  storageKey String
  createdAt  DateTime      @default(now())

  @@index([orderId])
}

// A buyer's cart is just their items: nothing is stored about the cart itself.
// Prices are never stored here; lines always use the listing's current price.
model CartItem {
  id        String   @id @default(uuid())
  buyerId   String
  buyer     Buyer    @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  produceId String
  produce   Produce  @relation(fields: [produceId], references: [id], onDelete: Cascade)
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([buyerId, produceId])
}

// One row per applied guest-cart merge: a retried POST /cart/items/bulk with
// the same key replays `skipped` instead of adding the quantities again.
model CartMerge {
  id             String   @id @default(uuid())
  buyerId        String
  buyer          Buyer    @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  idempotencyKey String
  skipped        Json
  createdAt      DateTime @default(now())

  @@unique([buyerId, idempotencyKey])
}

// One placement (cart or Buy Now): its orders, delivery and payment.
model Checkout {
  id                   String         @id @default(uuid())
  // Public code (CHK-000123), backed by a hand-made sequence like Order.orderNumber.
  checkoutNumber       String         @unique @default(dbgenerated("('CHK-'::text || lpad((nextval('\"Checkout_checkoutNumber_seq\"'::regclass))::text, 6, '0'::text))"))
  buyerId              String
  // Checkouts are history, like orders.
  buyer                Buyer          @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  // Client-generated per attempt (Idempotency-Key); a retry replays the original.
  idempotencyKey       String
  // subtotal + deliveryFee + serviceFee
  totalPrice           Decimal        @db.Decimal(12, 2)
  orders               Order[]
  // Set when an admin confirms a sourcing request. Several checkouts can
  // point at one request. At most one is AWAITING_PAYMENT: the hand-written
  // partial unique index Checkout_sourcingRequestId_awaiting_key.
  sourcingRequestId    String?
  sourcingRequest      SourcingRequest? @relation(fields: [sourcingRequestId], references: [id], onDelete: Restrict)
  createdAt            DateTime       @default(now())
  status               CheckoutStatus
  subtotal             Decimal        @db.Decimal(12, 2)
  deliveryFee          Decimal        @db.Decimal(12, 2)
  // SERVICE_FEE_PERCENT of subtotal, kept by Laicos; snapshotted like deliveryFee.
  serviceFee           Decimal        @db.Decimal(12, 2)
  // Reserved stock is released once this passes unpaid (CheckoutExpiryService).
  expiresAt            DateTime
  paidAt               DateTime?
  deliveryDate         DateTime       @db.Date
  // Snapshot of the chosen Address, as names, so later edits don't rewrite history.
  deliveryLabel        String
  deliveryStreet       String
  deliveryState        String
  deliveryLga          String
  deliveryContactName  String?
  deliveryContactPhone String?
  payments             Payment[]

  @@unique([buyerId, idempotencyKey])
  @@index([status, expiresAt])
  @@index([sourcingRequestId])
}

// A buyer's saved delivery address. At most one isDefault per buyer, enforced
// by the hand-written partial unique index Address_buyerId_default_key.
model Address {
  id           String   @id @default(uuid())
  buyerId      String
  buyer        Buyer    @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  label        String
  street       String
  stateId      String
  state        State    @relation(fields: [stateId], references: [id], onDelete: Restrict)
  lgaId        String
  lga          Lga      @relation(fields: [lgaId], references: [id], onDelete: Restrict)
  contactName  String?
  contactPhone String?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([buyerId])
}

// One attempt to pay a checkout. At most one SUCCEEDED per checkout, enforced
// by the hand-written partial unique index Payment_checkoutId_succeeded_key.
model Payment {
  id             String          @id @default(uuid())
  // Public code (PAY-000123), backed by a hand-made sequence like Checkout.checkoutNumber.
  // Also the Paystack transaction reference.
  reference      String          @unique @default(dbgenerated("('PAY-'::text || lpad((nextval('\"Payment_reference_seq\"'::regclass))::text, 6, '0'::text))"))
  checkoutId     String
  checkout       Checkout        @relation(fields: [checkoutId], references: [id], onDelete: Restrict)
  // Client-generated per attempt (Idempotency-Key); a retry replays the original.
  idempotencyKey String
  provider       PaymentProvider
  status         PaymentStatus   @default(PENDING)
  // The checkout total in NGN.
  amount         Decimal         @db.Decimal(12, 2)
  currency       Currency        @default(NGN)
  // What the buyer is charged in `currency`; equals amount for NGN.
  chargedAmount  Decimal         @db.Decimal(12, 2)
  // Effective NGN per USD fixed at initiation; null for NGN.
  fxRate         Decimal?        @db.Decimal(18, 6)
  channel        String?
  failureReason  String?
  // What the provider returned on initiate (authorization URL and access code).
  providerData   Json?
  // Set when an admin applied it (verify); null for webhook confirmations.
  confirmedById  String?
  confirmedBy    User?           @relation("PaymentConfirmedBy", fields: [confirmedById], references: [id], onDelete: Restrict)
  paidAt         DateTime?
  refunds        Refund[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([checkoutId, idempotencyKey])
}

enum CheckoutStatus {
  AWAITING_PAYMENT
  PAID
  EXPIRED
  CANCELLED
}

enum Currency {
  NGN
  USD
}

// STUB stays for rows created before Paystack.
enum PaymentProvider {
  STUB
  PAYSTACK
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  ABANDONED
  // Money arrived but could not be applied (late, duplicate or mismatched);
  // it is refunded automatically.
  ORPHANED
}

model FxRate {
  id        String   @id @default(uuid())
  // Market NGN per 1 USD, before FX_MARGIN_PERCENT.
  rate      Decimal  @db.Decimal(18, 6)
  source    String
  fetchedAt DateTime @default(now())

  @@index([fetchedAt])
}

enum RefundStatus {
  PENDING
  PROCESSED
  FAILED
}

model Refund {
  id               String       @id @default(uuid())
  paymentId        String
  payment          Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  // Null: a refund of the payment's remaining balance.
  orderId          String?
  order            Order?       @relation(fields: [orderId], references: [id], onDelete: Restrict)
  // In the payment's currency.
  amount           Decimal      @db.Decimal(12, 2)
  status           RefundStatus @default(PENDING)
  reason           String
  // Null when automatic (an orphaned payment).
  initiatedById    String?
  initiatedBy      User?        @relation("RefundInitiatedBy", fields: [initiatedById], references: [id], onDelete: Restrict)
  providerRefundId String?
  failureReason    String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([paymentId])
  @@index([providerRefundId])
}

model FarmerBankAccount {
  id               String   @id @default(uuid())
  farmerId         String   @unique
  farmer           Farmer   @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  bankCode         String
  bankName         String
  accountNumber    String
  // As Paystack resolved it; admins compare it with the farmer's name.
  accountName      String
  recipientCode    String
  setById          String
  setBy            User     @relation("BankAccountSetBy", fields: [setById], references: [id], onDelete: Restrict)
  // now + 24h on every change, so a hijacked login can't quietly redirect money.
  payoutsHeldUntil DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

enum PayoutStatus {
  PENDING
  SUCCEEDED
  FAILED
  REVERSED
}

model Payout {
  id            String       @id @default(uuid())
  // Public code (PO-000123), backed by a hand-made sequence like Payment.reference.
  reference     String       @unique @default(dbgenerated("('PO-'::text || lpad((nextval('\"Payout_reference_seq\"'::regclass))::text, 6, '0'::text))"))
  farmerId      String
  farmer        Farmer       @relation(fields: [farmerId], references: [id], onDelete: Restrict)
  // NGN.
  amount        Decimal      @db.Decimal(12, 2)
  // Snapshot of the account paid, so a later bank change never rewrites history.
  bankName      String
  accountNumber String
  accountName   String
  recipientCode String
  status        PayoutStatus @default(PENDING)
  transferCode  String?
  failureReason String?
  approvedById  String
  approvedBy    User         @relation("PayoutApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  paidAt        DateTime?
  items         PayoutItem[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([farmerId, status])
  @@index([status])
}

// An order is paid out at most once: the hand-written partial unique index
// PayoutItem_orderId_active_key covers items whose status is PENDING or
// SUCCEEDED. status mirrors Payout.status (always written in the same
// transaction) because an index can't see another table.
model PayoutItem {
  id       String       @id @default(uuid())
  payoutId String
  payout   Payout       @relation(fields: [payoutId], references: [id], onDelete: Cascade)
  orderId  String
  order    Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  amount   Decimal      @db.Decimal(12, 2)
  status   PayoutStatus @default(PENDING)

  @@index([orderId])
  @@index([payoutId])
}

// A buyer's request for produce they couldn't find listed. An admin assigns
// an agent, saves a group of listings, and confirm places one checkout.
model SourcingRequest {
  id                  String                @id @default(uuid())
  // Public code (REQ-000123), backed by a hand-made sequence like Order.orderNumber.
  requestNumber       String                @unique @default(dbgenerated("('REQ-'::text || lpad((nextval('\"SourcingRequest_requestNumber_seq\"'::regclass))::text, 6, '0'::text))"))
  buyerId             String
  // Requests are history, like orders.
  buyer               Buyer                 @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  // Free text: sourcing can be anything a farm produces.
  produceName         String
  quantity            Float
  unit                SourcingUnit
  quality             QualityGrade
  packaging           PackagingType
  condition           ProduceCondition
  additionalSpecs     String?
  deliveryDestination String
  requiredDate        DateTime              @db.Date
  timeline            SourcingTimeline
  logisticsNotes      String?
  status              SourcingRequestStatus @default(NEW)
  assignedAgentId     String?
  assignedAgent       Agent?                @relation(fields: [assignedAgentId], references: [id], onDelete: Restrict)
  escalatedAt         DateTime?
  closedAt            DateTime?
  closeReason         String?
  allocations         SourcingAllocation[]
  checkouts           Checkout[]
  auditEvents         AuditEvent[]
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@index([buyerId, createdAt])
  @@index([status, createdAt])
  @@index([assignedAgentId])
}

// One chosen listing on a request. Quantity is in that listing's unit.
// Saving it does not reserve stock; confirm does.
model SourcingAllocation {
  id                String          @id @default(uuid())
  sourcingRequestId String
  sourcingRequest   SourcingRequest @relation(fields: [sourcingRequestId], references: [id], onDelete: Cascade)
  produceId         String
  produce           Produce         @relation(fields: [produceId], references: [id], onDelete: Restrict)
  quantity          Int

  @@unique([sourcingRequestId, produceId])
  @@index([produceId])
}

// One per order, opened on first use by either side. The buyer side is Buyer;
// the agent side is the agent's User. Socket rooms still use User.id.
model Conversation {
  id              String    @id @default(uuid())
  orderId         String    @unique
  // Conversations are history, like orders.
  order           Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  buyerId         String
  buyer           Buyer     @relation("ConversationBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  // Fixed when the conversation opens and never re-resolved: a later cluster
  // agent doesn't inherit a history they weren't part of.
  agentUserId     String
  agentUser       User      @relation("ConversationAgent", fields: [agentUserId], references: [id], onDelete: Restrict)
  buyerLastReadAt DateTime?
  agentLastReadAt DateTime?
  // Null until the first message; lists sort on it without joining Message.
  lastMessageAt   DateTime?
  messages        Message[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([buyerId, lastMessageAt])
  @@index([agentUserId, lastMessageAt])
}

model Message {
  id              String       @id @default(uuid())
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  senderId        String
  sender          User         @relation(fields: [senderId], references: [id], onDelete: Restrict)
  body            String
  // Client-generated per send; a retry with the same key returns the original.
  clientMessageId String
  createdAt       DateTime     @default(now())

  @@unique([senderId, clientMessageId])
  @@index([conversationId, createdAt])
}

