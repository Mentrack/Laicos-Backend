generator client {
  provider     = "prisma-client"
  output       = "../generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String                 @id @default(uuid())
  firebaseUid           String                 @unique
  firstName             String
  lastName              String
  email                 String                 @unique
  phoneNumber           String?
  role                  Role
  agreedToTerms         Boolean                @default(false)
  // Mirrors Firebase's emailVerified;
  isVerified            Boolean                @default(false)
  // Farmers and agents only: set when a farmer's first farm is verified, or
  // (once the admin flow exists) when an admin verifies an agent. Until then
  // ActivationGuard locks them out. Other roles leave it null.
  activatedAt           DateTime?
  // Set with the temporary password sent in a farmer's invite;
  // PasswordChangeGuard blocks most routes until changePassword clears it.
  mustChangePassword    Boolean                @default(false)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  farmer                Farmer?
  agent                 Agent?
  orders                Order[]
  cartItems             CartItem[]
  checkouts             Checkout[]
  sourcingRequests      SourcingRequest[]
  addresses             Address[]
  confirmedPayments     Payment[]              @relation("PaymentConfirmedBy")
  refreshToken          RefreshToken?
  emailVerificationCode EmailVerificationCode?
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One live code per user; issuing a new one overwrites it.
model EmailVerificationCode {
  userId              String   @id
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // HMAC-SHA256 keyed by OTP_SECRET: a bare hash of 4 digits is reversible.
  codeHash            String
  expiresAt           DateTime
  attempts            Int      @default(0)
  lastSentAt          DateTime
  // Codes sent since sendWindowStartedAt; caps resends at a few a day.
  sendCount           Int      @default(0)
  sendWindowStartedAt DateTime @default(now())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Farmer {
  id            String   @id @default(uuid())
  // Public, human-readable code (FRM-000123). The sequence is created by hand in
  // the migration; Prisma only knows the column default that reads it.
  farmerId      String   @unique @default(dbgenerated("('FRM-'::text || lpad((nextval('\"Farmer_farmerId_seq\"'::regclass))::text, 6, '0'::text))"))
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Set at profile setup; the agent checks them during farm verification.
  idType        IdType?
  idNumber      String?
  // Private-bucket key.
  idDocumentKey String?
  farms         Farm[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Farm {
  id                   String                 @id @default(uuid())
  // Public, human-readable code (LF-000123), backed by a hand-made sequence
  // like Farmer.farmerId.
  farmCode             String                 @unique @default(dbgenerated("('LF-'::text || lpad((nextval('\"Farm_farmCode_seq\"'::regclass))::text, 6, '0'::text))"))
  // References Farmer.id, not the public Farmer.farmerId code.
  ownerId              String
  owner                Farmer                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name                 String
  country              String                 @default("NG")
  stateId              String
  state                State                  @relation(fields: [stateId], references: [id], onDelete: Restrict)
  // Verification is assigned to agents in this LGA.
  lgaId                String
  lga                  Lga                    @relation(fields: [lgaId], references: [id], onDelete: Restrict)
  // Street address; state and LGA are the structured part.
  location             String
  // Hectares.
  size                 Float
  unit                 String                 @default("ha")
  mainProduce          String
  isExporting          Boolean                @default(false)
  // Private-bucket keys, uploaded with the farm. Ownership is optional only
  // temporarily; restore NOT NULL once it is required again.
  ownershipDocumentKey String?
  chiefConfirmationKey String?
  // Denormalised from the latest FarmVerification and always written in the
  // same transaction, so lists filter on it without a join.
  verificationStatus   FarmVerificationStatus @default(PENDING)
  isClustered          Boolean                @default(false)
  // Restrict: deleting an agent (and with it their cluster) while farms are
  // still in it would otherwise leave those farms isClustered with no cluster.
  clusterId            String?
  cluster              Cluster?               @relation(fields: [clusterId], references: [id], onDelete: Restrict)
  // Informational only; plays no part in assignment.
  referralAgentId      String?
  referralAgent        Agent?                 @relation("FarmReferral", fields: [referralAgentId], references: [id], onDelete: SetNull)
  produce              Produce[]
  orders               Order[]
  verifications        FarmVerification[]
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@index([ownerId])
  @@index([lgaId])
  @@index([clusterId])
}

model State {
  id        String    @id @default(uuid())
  name      String    @unique
  lgas      Lga[]
  farms     Farm[]
  agents    Agent[]
  addresses Address[]
}

model Lga {
  id        String    @id @default(uuid())
  stateId   String
  state     State     @relation(fields: [stateId], references: [id], onDelete: Restrict)
  name      String
  farms     Farm[]
  agents    Agent[]
  addresses Address[]

  @@unique([stateId, name])
}

model Agent {
  id            String              @id @default(uuid())
  // Public code (AG-000123), backed by a hand-made sequence like Farmer.farmerId.
  agentId       String              @unique @default(dbgenerated("('AG-'::text || lpad((nextval('\"Agent_agentId_seq\"'::regclass))::text, 6, '0'::text))"))
  userId        String              @unique
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  country       String              @default("NG")
  // Location and ID are null until profile setup.
  stateId       String?
  state         State?              @relation(fields: [stateId], references: [id], onDelete: Restrict)
  lgaId         String?
  lga           Lga?                @relation(fields: [lgaId], references: [id], onDelete: Restrict)
  idType        IdType?
  idNumber      String?
  // Private-bucket key.
  idDocumentKey String?
  // Set by an admin; only verified agents are assigned farms.
  isVerified    Boolean             @default(false)
  verifiedAt    DateTime?
  cluster       Cluster?
  verifications FarmVerification[]
  declines      AssignmentDecline[]
  handovers     OrderHandover[]
  referredFarms Farm[]              @relation("FarmReferral")
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([lgaId, isVerified])
}

// Exactly one per agent, created with it: the farms that agent manages.
model Cluster {
  id        String   @id @default(uuid())
  agentId   String   @unique
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  // "<LGA> Hub", set whenever the agent sets their LGA.
  name      String?
  farms     Farm[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One verification round of a farm. A farm keeps every round, and at most one
// is open (UNASSIGNED/ASSIGNED/IN_PROGRESS): a partial unique index
// hand-written in the migration, because Prisma can't express one.
model FarmVerification {
  id                 String                 @id @default(uuid())
  farmId             String
  farm               Farm                   @relation(fields: [farmId], references: [id], onDelete: Cascade)
  agentId            String?
  agent              Agent?                 @relation(fields: [agentId], references: [id], onDelete: SetNull)
  status             VerificationTaskStatus @default(UNASSIGNED)
  // Location step. false is a discrepancy: needs lat, lng, a note and evidence.
  locationMatches    Boolean?
  discrepancyLat     Decimal?               @db.Decimal(9, 6)
  discrepancyLng     Decimal?               @db.Decimal(9, 6)
  discrepancyNote    String?
  identityNote       String?
  // Measured on site; never overwrites Farm.size.
  measuredSize       Float?
  estimatedYield     Float?
  estimatedYieldUnit String?
  generalNote        String?
  rejectionReason    String?
  startedAt          DateTime?
  decidedAt          DateTime?
  checks             VerificationCheck[]
  evidence           VerificationEvidence[]
  declines           AssignmentDecline[]
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([farmId])
  @@index([agentId, status])
  @@index([status])
}

model VerificationCheck {
  id             String               @id @default(uuid())
  verificationId String
  verification   FarmVerification     @relation(fields: [verificationId], references: [id], onDelete: Cascade)
  key            VerificationCheckKey
  result         CheckResult
  note           String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([verificationId, key])
}

// A CHECK constraint in the migration ties checkKey to kind CHECK and
// photoSlot to kind PHOTO.
model VerificationEvidence {
  id             String                @id @default(uuid())
  verificationId String
  verification   FarmVerification      @relation(fields: [verificationId], references: [id], onDelete: Cascade)
  kind           EvidenceKind
  checkKey       VerificationCheckKey?
  photoSlot      PhotoSlot?
  // Private-bucket key.
  storageKey     String
  createdAt      DateTime              @default(now())

  @@index([verificationId])
}

model AssignmentDecline {
  id             String           @id @default(uuid())
  verificationId String
  verification   FarmVerification @relation(fields: [verificationId], references: [id], onDelete: Cascade)
  agentId        String
  agent          Agent            @relation(fields: [agentId], references: [id], onDelete: Cascade)
  reason         String
  createdAt      DateTime         @default(now())

  @@unique([verificationId, agentId])
}

model Produce {
  id               String           @id @default(uuid())
  farmId           String
  farm             Farm             @relation(fields: [farmId], references: [id], onDelete: Cascade)
  name             String
  // Original stock listed at creation. Immutable: actual/floating move as
  // orders come in, but this stays the record of what was first listed.
  quantity         Int
  // Stock not yet committed to a CONFIRMED order; mirrors quantity on
  // creation, drops on confirm.
  actualQuantity   Int
  // Stock buyers can still order: actual minus PENDING reservations; mirrors
  // quantity on creation, drops on order.
  floatingQuantity Int
  // Unit the quantities and pricePerUnit are expressed in, e.g. "kg" or "crate".
  unit             String
  pricePerUnit     Decimal          @db.Decimal(12, 2)
  imageUrl         String?
  status           ProduceStatus    @default(DRAFT)
  type             ProduceType      @default(LOCAL)
  // Optional so listings created before categories existed stay valid.
  category         ProduceCategory?
  description      String?
  // Short free text shown as "Specs", e.g. "Grade A — Fresh Harvest".
  specs            String?
  cartItems        CartItem[]
  orders           Order[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  // Target of Order's composite FK, so an order's farm always matches its produce's farm.
  @@unique([id, farmId])
  @@index([farmId])
}

model Order {
  id                 String          @id @default(uuid())
  // Public, human-readable code (ORD-000123), backed by a hand-made sequence
  // like Farmer.farmerId.
  orderNumber        String          @unique @default(dbgenerated("('ORD-'::text || lpad((nextval('\"Order_orderNumber_seq\"'::regclass))::text, 6, '0'::text))"))
  produceId          String
  farmId             String
  buyerId            String
  // Orders are history: Restrict stops a produce, farm or buyer delete from erasing them.
  produce            Produce         @relation(fields: [produceId, farmId], references: [id, farmId], onDelete: Restrict)
  farm               Farm            @relation(fields: [farmId], references: [id], onDelete: Restrict)
  buyer              User            @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  quantity           Int
  totalPrice         Decimal         @db.Decimal(12, 2)
  status             OrderStatus     @default(PENDING)
  // Snapshot of the produce's name at order time: lists show it without a
  // join, and a later rename doesn't rewrite order history.
  produceName        String
  // Snapshot of the produce's type at order time, so lists can tag and filter
  // local vs export orders without joining Produce.
  type               ProduceType
  // Null for Buy Now orders (POST /orders) and those placed before checkout.
  checkoutId         String?
  checkout           Checkout?       @relation(fields: [checkoutId], references: [id], onDelete: Restrict)
  // Required whenever status is CANCELLED.
  cancellationReason String?
  // Created when the farmer starts preparing; READY needs every item ticked.
  checklist          OrderChecklist?
  // Created when the order is marked READY; the agent takes it from there.
  handover           OrderHandover?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([farmId])
  @@index([produceId])
  @@index([buyerId])
  @@index([checkoutId])
}

model OrderChecklist {
  orderId        String   @id
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  harvested      Boolean  @default(false)
  sorted         Boolean  @default(false)
  packaged       Boolean  @default(false)
  readyForPickup Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// The agent's side of a READY order: verify the goods at the farm, then hand
// them to logistics, which ships the order. Opened by OrderService.markReady.
model OrderHandover {
  orderId          String         @id
  order            Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // The agent whose cluster held the farm when the order became READY. Null
  // when the farm was out of every cluster (mid re-verification); approving
  // the farm's next round claims it.
  agentId          String?
  agent            Agent?         @relation(fields: [agentId], references: [id], onDelete: SetNull)
  status           HandoverStatus @default(PENDING)
  verificationNote String?
  verifiedAt       DateTime?
  // Who took the goods; there is no logistics model yet.
  recipientName    String?
  recipientPhone   String?
  handoverNote     String?
  handedOverAt     DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([agentId, status])
}

// A buyer's cart is just their items: nothing is stored about the cart itself.
// Prices are never stored here; lines always use the listing's current price.
model CartItem {
  id        String   @id @default(uuid())
  buyerId   String
  buyer     User     @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  produceId String
  produce   Produce  @relation(fields: [produceId], references: [id], onDelete: Cascade)
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([buyerId, produceId])
}

// One placement (cart or Buy Now): its orders, delivery and payment.
model Checkout {
  id                   String         @id @default(uuid())
  // Public code (CHK-000123), backed by a hand-made sequence like Order.orderNumber.
  checkoutNumber       String         @unique @default(dbgenerated("('CHK-'::text || lpad((nextval('\"Checkout_checkoutNumber_seq\"'::regclass))::text, 6, '0'::text))"))
  buyerId              String
  // Checkouts are history, like orders.
  buyer                User           @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  // Client-generated per attempt (Idempotency-Key); a retry replays the original.
  idempotencyKey       String
  // subtotal + deliveryFee
  totalPrice           Decimal        @db.Decimal(12, 2)
  orders               Order[]
  createdAt            DateTime       @default(now())
  status               CheckoutStatus
  subtotal             Decimal        @db.Decimal(12, 2)
  deliveryFee          Decimal        @db.Decimal(12, 2)
  // Reserved stock is released once this passes unpaid (CheckoutExpiryService).
  expiresAt            DateTime
  paidAt               DateTime?
  deliveryDate         DateTime       @db.Date
  // Snapshot of the chosen Address, as names, so later edits don't rewrite history.
  deliveryLabel        String
  deliveryStreet       String
  deliveryState        String
  deliveryLga          String
  deliveryContactName  String?
  deliveryContactPhone String?
  payments             Payment[]

  @@unique([buyerId, idempotencyKey])
  @@index([status, expiresAt])
}

// A buyer's saved delivery address. At most one isDefault per buyer, enforced
// by the hand-written partial unique index Address_buyerId_default_key.
model Address {
  id           String   @id @default(uuid())
  buyerId      String
  buyer        User     @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  label        String
  street       String
  stateId      String
  state        State    @relation(fields: [stateId], references: [id], onDelete: Restrict)
  lgaId        String
  lga          Lga      @relation(fields: [lgaId], references: [id], onDelete: Restrict)
  contactName  String?
  contactPhone String?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([buyerId])
}

// One attempt to pay a checkout. At most one SUCCEEDED per checkout, enforced
// by the hand-written partial unique index Payment_checkoutId_succeeded_key.
model Payment {
  id             String          @id @default(uuid())
  // Public code (PAY-000123), backed by a hand-made sequence like Checkout.checkoutNumber.
  // Bank transfer buyers quote it as the narration.
  reference      String          @unique @default(dbgenerated("('PAY-'::text || lpad((nextval('\"Payment_reference_seq\"'::regclass))::text, 6, '0'::text))"))
  checkoutId     String
  checkout       Checkout        @relation(fields: [checkoutId], references: [id], onDelete: Restrict)
  // Client-generated per attempt (Idempotency-Key); a retry replays the original.
  idempotencyKey String
  method         PaymentMethod
  provider       PaymentProvider
  status         PaymentStatus   @default(PENDING)
  amount         Decimal         @db.Decimal(12, 2)
  // What the provider returned on initiate (e.g. transfer instructions).
  providerData   Json?
  // Set when an admin confirmed it by hand; null for provider confirmations.
  confirmedById  String?
  confirmedBy    User?           @relation("PaymentConfirmedBy", fields: [confirmedById], references: [id], onDelete: Restrict)
  paidAt         DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([checkoutId, idempotencyKey])
}

enum CheckoutStatus {
  AWAITING_PAYMENT
  PAID
  EXPIRED
  CANCELLED
}

enum PaymentMethod {
  CARD
  BANK_TRANSFER
}

enum PaymentProvider {
  STUB
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  ABANDONED
}

// A buyer's request for produce they couldn't find listed. Admin handling is
// not built yet; status stays UNDER_REVIEW until it is.
model SourcingRequest {
  id                  String                @id @default(uuid())
  // Public code (REQ-000123), backed by a hand-made sequence like Order.orderNumber.
  requestNumber       String                @unique @default(dbgenerated("('REQ-'::text || lpad((nextval('\"SourcingRequest_requestNumber_seq\"'::regclass))::text, 6, '0'::text))"))
  buyerId             String
  // Requests are history, like orders.
  buyer               User                  @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  // Free text: sourcing can be anything a farm produces.
  produceName         String
  quantity            Float
  unit                SourcingUnit
  quality             QualityGrade
  packaging           PackagingType
  condition           ProduceCondition
  additionalSpecs     String?
  deliveryDestination String
  requiredDate        DateTime              @db.Date
  timeline            SourcingTimeline
  logisticsNotes      String?
  status              SourcingRequestStatus @default(UNDER_REVIEW)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@index([buyerId, createdAt])
}

enum SourcingUnit {
  KG
  TONNES
  BAGS
  CRATES
  BASKETS
  LITRES
  PIECES
}

enum QualityGrade {
  GRADE_A
  GRADE_B
  GRADE_C
  MIXED
}

enum PackagingType {
  BAGS
  SACKS
  CRATES
  CARTONS
  BULK
  OTHER
}

enum ProduceCondition {
  FRESH
  DRIED
  PROCESSED
  FROZEN
}

enum SourcingTimeline {
  WITHIN_1_WEEK
  WITHIN_2_WEEKS
  WITHIN_1_MONTH
  FLEXIBLE
}

enum SourcingRequestStatus {
  UNDER_REVIEW
}

enum HandoverStatus {
  PENDING
  VERIFIED
  HANDED_OVER
}

enum IdType {
  NIN
  VOTERS_CARD
}

enum FarmVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum VerificationTaskStatus {
  UNASSIGNED
  ASSIGNED
  IN_PROGRESS
  APPROVED
  REJECTED
}

enum CheckResult {
  VERIFIED
  ISSUE
  UNABLE
  NOT_APPLICABLE
}

enum VerificationCheckKey {
  FARMER_ID
  FARM_OWNERSHIP
  CHIEF_CONFIRMATION
  FARM_ACTIVE
  ACCESS_ROUTE
  MEASUREMENTS
  DECLARED_PRODUCE
  CROP_HEALTH
  ESTIMATED_YIELD
}

enum EvidenceKind {
  CHECK
  LOCATION_DISCREPANCY
  PHOTO
}

enum PhotoSlot {
  ENTRANCE
  FARM_AREA
  PRODUCE
  INFRASTRUCTURE
}

enum OrderStatus {
  // Placed but unpaid: hidden from farmers until payment is confirmed.
  AWAITING_PAYMENT
  PENDING
  CONFIRMED
  PREPARING
  READY
  SHIPPED
  FULFILLED
  CANCELLED
}

enum ProduceStatus {
  DRAFT
  PUBLISHED
  SOLD_OUT
}

enum ProduceCategory {
  GRAINS
  TUBERS
  LEGUMES
  OILSEEDS
  VEGETABLES
  FRUITS
  NUTS
  SPICES
  OTHER
}

enum ProduceType {
  LOCAL
  EXPORT
}

enum Role {
  FARMER
  BUYER
  EXTENSION_AGENT
  RIDER
  ADMIN
}
