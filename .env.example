# App
PORT=8080
NODE_ENV=development
BASE_URL=
FRONTEND_WEBAPP_URL=http://localhost:3000

POSTGRES_USER=laicos
POSTGRES_PASSWORD=laicos
POSTGRES_DB=laicos
POSTGRES_PORT=5434
DATABASE_URL=postgresql://laicos:laicos@localhost:5434/laicos

REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=laicos

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_API_KEY=

# Password `pnpm seed` sets on every seeded Firebase account. Optional.
# SEED_USER_PASSWORD=Laicos@2026
# Deployed envs only: run the seed on every container start, after migrations.
# It resets the seed users' passwords and the seed rows each time. Never set it
# on production.
# SEED_ON_DEPLOY=true

# Email (nodemailer). Required; the app verifies the connection at boot.
# Local: MailHog from docker compose, no auth (UI on MAILHOG_UI_PORT).
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=<address> and
# SMTP_PASS=<a Google App Password>; the account needs 2-step verification.
# Set SMTP_USER and SMTP_PASS together, or neither.
SMTP_HOST=localhost
SMTP_PORT=1026
SMTP_USER=
SMTP_PASS=
MAIL_FROM="LAICOS <no-reply@laicos.local>"
# Keys the hash of email verification codes. Any long random string;
# rotating it invalidates codes already sent.
OTP_SECRET=change-me-to-a-long-random-string
# MAILHOG_UI_PORT=8026

S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BUCKET=
S3_PRIVATE_BUCKET=
S3_PUBLIC_URL_BASE=
# Checkout. Validated at boot. The fee is a flat naira amount per checkout.
DELIVERY_FEE=3500
# How long placed orders hold stock awaiting payment; a bank transfer
# extends the hold to BANK_TRANSFER_HOLD_HOURS from when it is started.
CHECKOUT_HOLD_MINUTES=30
BANK_TRANSFER_HOLD_HOURS=24
# Delivery date window, in days from today (Africa/Lagos).
DELIVERY_MIN_DAYS=1
DELIVERY_MAX_DAYS=30
# Shown to buyers paying by bank transfer.
ESCROW_BANK_NAME=Test Bank
ESCROW_ACCOUNT_NAME=LAICOS Escrow
ESCROW_ACCOUNT_NUMBER=0000000000
