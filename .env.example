# App
PORT=8080
# development | staging | production. Startup prints the server and docs URLs in development and staging.
NODE_ENV=development
# Public base URL for those startup logs; defaults to http://localhost:$PORT.
# BASE_URL=
# Comma-separated CORS allowlist (no wildcard)
FRONTEND_WEBAPP_URL=http://localhost:3000

# Postgres (docker-compose)
POSTGRES_USER=laicos
POSTGRES_PASSWORD=laicos
POSTGRES_DB=laicos
POSTGRES_PORT=5434
# Literal, not ${VAR}-interpolated: prisma.config.ts loads this via plain dotenv, which does not expand variables.
DATABASE_URL=postgresql://laicos:laicos@localhost:5434/laicos

# Redis (docker-compose) — BullMQ
REDIS_HOST=localhost
REDIS_PORT=6380

# Firebase — all required; the app refuses to boot without them.
# Admin SDK service account (Project settings -> Service accounts).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# One line, newlines escaped as \n.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Web API key (Project settings -> General) — for password sign-in, refresh and reset.
FIREBASE_API_KEY=

# SMTP (MailHog in dev)
SMTP_HOST=localhost
SMTP_PORT=1026
MAILHOG_UI_PORT=8026

# Object storage (S3-compatible; Supabase Storage here). All required except
# S3_SKIP_BUCKET_CHECK; the app refuses to boot if a bucket doesn't exist.
S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BUCKET=
S3_PRIVATE_BUCKET=
# Public object read base — a different path than S3_ENDPOINT, so it can't be
# derived from it.
S3_PUBLIC_URL_BASE=https://<project-ref>.supabase.co/storage/v1/object/public
# Skips the boot-time bucket HEAD check. Leave unset except in CI.
# S3_SKIP_BUCKET_CHECK=true
